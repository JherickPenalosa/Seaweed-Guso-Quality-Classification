"""Secure gUSo password recovery using an already-verified mobile number.

Used by the existing POST /auth/password-reset/request and /confirm routes.
Email may identify an account, but codes are ONLY delivered to its verified
mobile number. This does not provide email verification or email delivery.

The SMS adapter is app.services.sms_service: local-console test mode stays
restricted to the dedicated development account; Semaphore remains the
production delivery option. OTPs are never returned by this module.
"""

import logging
from datetime import datetime, timedelta, timezone

from fastapi import HTTPException, status
from sqlalchemy.orm import Session

from app.core.otp import (
    OTP_EXPIRATION_MINUTES,
    OTP_MAX_ATTEMPTS,
    OTP_RESEND_COOLDOWN_SECONDS,
)
from app.core.security import (
    generate_password_reset_otp,
    hash_password,
    hash_password_reset_otp,
    verify_password_reset_otp,
)
from app.database.models import OtpVerification, User
from app.database.repository import get_user_by_contact_num, get_user_by_email
from app.services.sms_service import normalize_mobile_number, send_verification_sms

logger = logging.getLogger(__name__)

PASSWORD_RESET_PURPOSE = "password_reset"
MAX_RESET_REQUESTS_PER_HOUR = 5
_INVALID_CODE = "Invalid or expired recovery code. Request a new code if necessary."


def _utc_now() -> datetime:
    """Naive UTC to match the existing SQLAlchemy DateTime columns."""
    return datetime.now(timezone.utc).replace(tzinfo=None)


def _naive_utc(value: datetime) -> datetime:
    if value.tzinfo is not None and value.utcoffset() is not None:
        return value.astimezone(timezone.utc).replace(tzinfo=None)
    return value


def _find_user(db: Session, identifier: str) -> User | None:
    """Resolve email or supported PH phone formats, without revealing the result."""
    if not isinstance(identifier, str):
        return None
    entered = identifier.strip()
    if not entered:
        return None

    if "@" in entered:
        return get_user_by_email(db, entered.lower())

    try:
        normalized = normalize_mobile_number(entered)
    except (TypeError, ValueError):
        return None

    national = normalized[2:]
    variants = (entered, "0" + national, normalized, "+" + normalized, national)
    for number in dict.fromkeys(variants):
        user = get_user_by_contact_num(db, number)
        if user is not None:
            return user
    return None


def _verified_destination(user: User) -> str | None:
    """An identifier alone is NEVER proof of ownership or a recovery channel."""
    if not (bool(user.is_verified) and bool(user.contact_verified)):
        return None
    try:
        return normalize_mobile_number(user.contact_num)
    except (TypeError, ValueError):
        return None


def _pending_code(db: Session, user_id: int, *, lock: bool = False):
    query = (
        db.query(OtpVerification)
        .filter(
            OtpVerification.user_id == user_id,
            OtpVerification.purpose == PASSWORD_RESET_PURPOSE,
            OtpVerification.verified_at.is_(None),
        )
        .order_by(
            OtpVerification.created_at.desc(),
            OtpVerification.otp_id.desc(),
        )
    )
    return (query.with_for_update() if lock else query).first()


def request_password_reset(db: Session, identifier: str) -> None:
    """Send a recovery OTP only to a VERIFIED mobile number.

    The caller always returns the same HTTP 202 message. Unknown accounts,
    unverified accounts, cooldowns, quota exhaustion, and SMS delivery errors
    must not reveal account existence in the HTTP response.
    """
    found = _find_user(db, identifier)
    if found is None:
        return

    # Serialize concurrent requests for the same account in PostgreSQL.
    user = (
        db.query(User)
        .filter(User.user_id == found.user_id)
        .with_for_update()
        .first()
    )
    if user is None:
        return
    destination = _verified_destination(user)
    if destination is None:
        db.rollback()
        return

    now = _utc_now()
    previous = _pending_code(db, user.user_id)
    if previous is not None and previous.created_at is not None:
        elapsed = (now - _naive_utc(previous.created_at)).total_seconds()
        if elapsed < OTP_RESEND_COOLDOWN_SECONDS:
            db.rollback()
            return

    hourly_count = (
        db.query(OtpVerification)
        .filter(
            OtpVerification.user_id == user.user_id,
            OtpVerification.purpose == PASSWORD_RESET_PURPOSE,
            OtpVerification.created_at >= now - timedelta(hours=1),
        )
        .count()
    )
    if hourly_count >= MAX_RESET_REQUESTS_PER_HOUR:
        db.rollback()
        return

    code = generate_password_reset_otp()
    # Invalidate only older PASSWORD RESET codes, never registration OTPs.
    (
        db.query(OtpVerification)
        .filter(
            OtpVerification.user_id == user.user_id,
            OtpVerification.purpose == PASSWORD_RESET_PURPOSE,
            OtpVerification.verified_at.is_(None),
            OtpVerification.expires_at > now,
        )
        .update({OtpVerification.expires_at: now}, synchronize_session=False)
    )
    db.add(
        OtpVerification(
            user_id=user.user_id,
            purpose=PASSWORD_RESET_PURPOSE,
            otp_hash=hash_password_reset_otp(user.user_id, code),
            attempts=0,
            created_at=now,
            expires_at=now + timedelta(minutes=OTP_EXPIRATION_MINUTES),
        )
    )
    db.flush()

    try:
        # Local console delivery is restricted by sms_service settings;
        # production uses the configured real SMS provider.
        send_verification_sms(destination, code)
    except Exception:
        db.rollback()  # Never leave a usable code after delivery failure.
        logger.warning("Password recovery delivery failed (no OTP was activated).")
        return

    try:
        db.commit()
    except Exception:
        db.rollback()
        raise


def confirm_password_reset(
    db: Session,
    identifier: str,
    code: str,
    new_password: str,
) -> None:
    """Atomically consume one OTP, set the password, and revoke old JWTs."""
    found = _find_user(db, identifier)
    if found is None:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=_INVALID_CODE)

    # Lock the account to avoid two simultaneous successful resets.
    user = (
        db.query(User)
        .filter(User.user_id == found.user_id)
        .with_for_update()
        .first()
    )
    if user is None or _verified_destination(user) is None:
        db.rollback()
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=_INVALID_CODE)

    record = _pending_code(db, user.user_id, lock=True)
    now = _utc_now()
    if record is None or record.expires_at is None or now >= _naive_utc(record.expires_at):
        db.rollback()
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=_INVALID_CODE)

    if record.attempts >= OTP_MAX_ATTEMPTS:
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_429_TOO_MANY_REQUESTS,
            detail="Too many incorrect attempts. Request a new recovery code.",
        )

    if not verify_password_reset_otp(user.user_id, code, record.otp_hash):
        record.attempts += 1
        if record.attempts >= OTP_MAX_ATTEMPTS:
            record.expires_at = now
        db.commit()  # Failed attempts MUST persist even though the request fails.
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=_INVALID_CODE)

    if not isinstance(new_password, str) or len(new_password) < 8:
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="The new password must contain at least eight characters.",
        )

    try:
        user.password_hash = hash_password(new_password)
        user.auth_token_version = int(user.auth_token_version or 0) + 1
        record.verified_at = now  # Single-use recovery code.
        db.flush()
        # Invalidate any other recovery codes for this account.
        (
            db.query(OtpVerification)
            .filter(
                OtpVerification.user_id == user.user_id,
                OtpVerification.purpose == PASSWORD_RESET_PURPOSE,
                OtpVerification.otp_id != record.otp_id,
                OtpVerification.verified_at.is_(None),
                OtpVerification.expires_at > now,
            )
            .update({OtpVerification.expires_at: now}, synchronize_session=False)
        )
        db.commit()
    except Exception:
        db.rollback()
        raise
